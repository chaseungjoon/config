// Floating, transparent "pill" bar — Catppuccin Mocha palette (matches rofi)
{
  "layer": "top",
  "position": "top",
  "height": 40,
  "margin-top": 6,
  "margin-left": 10,
  "margin-right": 10,
  "spacing": 6,
  "reload_style_on_change": true,

  "modules-left":   ["custom/logo", "hyprland/workspaces", "hyprland/window"],
  "modules-center": ["clock", "mpris"],
  "modules-right":  ["tray", "group/system", "battery", "custom/power"],

  "custom/logo": {
    "format": "󰣇",
    "tooltip": false,
    "on-click": "rofi -show drun"
  },

  "hyprland/workspaces": {
    "format": "{id}",
    "persistent-workspaces": { "*": 5 },
    "on-scroll-up": "hyprctl dispatch workspace e-1",
    "on-scroll-down": "hyprctl dispatch workspace e+1"
  },

  "hyprland/window": {
    "format": "{title}",
    "max-length": 40,
    "separate-outputs": true,
    "rewrite": { "": "" }
  },

  "clock": {
    "format": "{:%H:%M}",
    "format-alt": "{:%a %d %b  %H:%M}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "on-scroll": 1,
      "format": {
        "months":   "<span color='#cba6f7'><b>{}</b></span>",
        "weekdays": "<span color='#7f849c'><b>{}</b></span>",
        "today":    "<span color='#89b4fa'><b><u>{}</u></b></span>"
      }
    },
    "actions": { "on-scroll-up": "shift_up", "on-scroll-down": "shift_down" }
  },

  "mpris": {
    "format": "{status_icon} {title}",
    "status-icons": { "playing": "󰏤", "paused": "󰐊", "stopped": "󰓛" },
    "max-length": 30,
    "on-click": "playerctl play-pause",
    "on-scroll-up": "playerctl next",
    "on-scroll-down": "playerctl previous"
  },

  // Wi-Fi (nm-applet) and Bluetooth (blueman-applet) show up here
  "tray": { "icon-size": 18, "spacing": 10 },

  "group/system": {
    "orientation": "horizontal",
    "modules": ["bluetooth", "group/audio", "cpu", "memory", "disk"]
  },

  "bluetooth": {
    "format": "󰂯",
    "format-disabled": "󰂲",
    "format-off": "󰂲",
    "format-connected": "󰂱",
    "tooltip-format": "Bluetooth: {status}",
    "tooltip-format-connected": "{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}",
    "on-click": "~/.config/waybar/scripts/bluetooth.sh",
    "on-click-right": "blueman-manager"
  },

  // Hover the speaker icon to reveal a draggable volume slider
  "group/audio": {
    "orientation": "horizontal",
    "drawer": { "transition-duration": 250, "transition-left-to-right": false },
    "modules": ["pulseaudio", "pulseaudio/slider"]
  },

  "pulseaudio/slider": { "min": 0, "max": 100, "orientation": "horizontal" },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟",
    "format-icons": { "headphone": "󰋋", "default": ["󰕿", "󰖀", "󰕾"] },
    "scroll-step": 5,
    "on-click": "~/.config/waybar/scripts/sound.sh",
    "on-click-middle": "pavucontrol",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
  },

  "backlight": {
    "format": "{icon} {percent}%",
    "format-icons": ["󰃞", "󰃟", "󰃠"],
    "on-scroll-up": "brightnessctl set 5%+",
    "on-scroll-down": "brightnessctl set 5%-"
  },

  "cpu":    { "format": "󰍛 {usage}%", "interval": 5 },
  "memory": { "format": "󰘚 {percentage}%", "interval": 10,
              "tooltip-format": "{used:0.1f}G / {total:0.1f}G" },
  "disk":   { "format": "󰋊 {percentage_used}%", "path": "/", "interval": 60,
              "tooltip-format": "{used} / {total} used ({free} free)" },

  "battery": {
    "states": { "warning": 30, "critical": 15 },
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰚥 {capacity}%",
    "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "tooltip-format": "{timeTo}"
  },

  "custom/power": {
    "format": "󰐥",
    "tooltip-format": "Shut down / Restart / Log out",
    "on-click": "~/.config/waybar/scripts/power.sh"
  }
}
