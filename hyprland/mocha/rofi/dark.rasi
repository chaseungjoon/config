/* Catppuccin Mocha–style dark theme */
* {
    bg:       #1e1e2ee6;
    bg-alt:   #313244;
    fg:       #cdd6f4;
    fg-dim:   #7f849c;
    accent:   #89b4fa;

    background-color: transparent;
    text-color:       @fg;
    margin:  0;
    padding: 0;
    spacing: 0;
}

window {
    width:            600px;
    location:         center;
    background-color: @bg;
    border:           2px;
    border-color:     @accent;
    border-radius:    14px;
}

mainbox {
    padding:  16px;
    spacing:  12px;
    children: [ inputbar, listview ];
}

inputbar {
    background-color: @bg-alt;
    border-radius:    10px;
    padding:          10px 14px;
    spacing:          10px;
    children:         [ prompt, entry ];
}

prompt { text-color: @accent; }

entry {
    placeholder:       "Search…";
    placeholder-color: @fg-dim;
    cursor:            text;
}

listview {
    lines:        8;
    columns:      1;
    fixed-height: true;
    scrollbar:    false;
    spacing:      4px;
}

element {
    padding:       8px 12px;
    border-radius: 8px;
    spacing:       12px;
}

element normal.normal,
element alternate.normal { background-color: transparent; text-color: @fg; }

element selected.normal  { background-color: @accent; text-color: #1e1e2e; }

element-icon {
    size:        24px;
    text-color:  inherit;
    cursor:      inherit;
}

element-text {
    text-color:       inherit;
    vertical-align:   0.5;
    cursor:           inherit;
}
