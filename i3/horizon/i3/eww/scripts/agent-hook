#!/usr/bin/env python3
# Codex lifecycle hook (registered in ~/.codex/hooks.json) -> live state for the bar's agent icons.
# Codex gives every hook a JSON object on stdin (session_id, hook_event_name, tool_name, ...);
# this records what that session is doing in $XDG_RUNTIME_DIR/agents/codex/<session_id>.json:
#   working  - prompt submitted / a tool is running
#   input    - Codex is waiting on you (approval request, or it asked you a question)
#   done     - the turn finished
# Never blocks or fails a hook: no output, always exit 0.
import json, os, sys, time

try:
    ev = json.load(sys.stdin)
except Exception:
    sys.exit(0)
sid = str(ev.get("session_id") or ev.get("thread_id") or "")
name = ev.get("hook_event_name") or ev.get("event") or ""
if not sid:
    sys.exit(0)
tool = str(ev.get("tool_name") or "")
state = {
    "SessionStart": "ready",
    "UserPromptSubmit": "working",
    "PreToolUse": "input" if tool in ("request_user_input", "ask_user", "AskUserQuestion") else "working",
    "PostToolUse": "working",
    "PermissionRequest": "input",
    "SubagentStart": "working",
    "Stop": "done",
    "Interrupt": "done",
}.get(name)
d = os.path.join(os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}", "agents", "codex")
f = os.path.join(d, sid + ".json")
try:
    os.makedirs(d, exist_ok=True)
    if name == "SessionEnd":
        os.unlink(f)
    elif state:
        tmp = f + ".tmp"
        with open(tmp, "w") as fh:
            json.dump({"state": state, "event": name, "ts": time.time(),
                       "transcript": ev.get("transcript_path") or ""}, fh)
        os.replace(tmp, f)
except OSError:
    pass
sys.exit(0)
