#!/usr/bin/env python3
# Build eww/worldcities.tsv (city <TAB> country <TAB> tz <TAB> kind) for the world-clock picker:
#   * every country's capital (kind "capital")
#   * every city in the system tz database (/usr/share/zoneinfo/zone.tab + iso3166.tab)
#   * well-known cities that aren't tz names (San Francisco, Osaka, Mumbai, ...)
# Every tz is validated with zoneinfo; duplicates (same city + tz) are dropped.
import os, zoneinfo

OUT = os.path.expanduser("~/.config/i3/eww/worldcities.tsv")

