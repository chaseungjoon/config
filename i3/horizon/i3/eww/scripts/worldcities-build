United Arab Emirates|Dubai|Asia/Dubai
Saudi Arabia|Jeddah|Asia/Riyadh
Israel|Tel Aviv|Asia/Jerusalem
— |UTC|UTC
"""

valid = zoneinfo.available_timezones()
iso = {}
for l in open("/usr/share/zoneinfo/iso3166.tab"):
    if l.startswith("#") or "\t" not in l:
        continue
    code, name = l.rstrip("\n").split("\t", 1)
    iso[code] = name

rows, seen, bad = [], set(), []


def add(city, country, tz, kind):
    if tz not in valid:
        bad.append(f"{city} ({tz})")
        return
    key = (city.lower(), tz)
    if key in seen:
        return
    seen.add(key)
    rows.append((city, country, tz, kind))


for l in CAPITALS.strip().splitlines():
    country, city, tz = l.split("|")
    add(city, country, tz, "capital")
for l in EXTRAS.strip().splitlines():
    country, city, tz = l.split("|")
    add(city, country.strip(" —"), tz, "city")
for l in open("/usr/share/zoneinfo/zone.tab"):
    if l.startswith("#"):
        continue
    f = l.rstrip("\n").split("\t")
    codes, tz = f[0], f[2]
    city = tz.rsplit("/", 1)[-1].replace("_", " ")
    country = iso.get(codes.split(",")[0], codes)
    add(city, country, tz, "zone")

rows.sort(key=lambda r: (r[0].lower(), r[1].lower()))
with open(OUT, "w") as f:
    for r in rows:
        f.write("\t".join(r) + "\n")
print(f"{len(rows)} cities -> {OUT}")
if bad:
    print("skipped (unknown tz):", ", ".join(bad))
