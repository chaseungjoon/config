#!/usr/bin/env python3
# eww listener for the bar's coding-agent icons (Claude Code + Codex + Copilot in any terminal).
#
# stdout (deflisten `agents`): JSON list of session ids, printed only when sessions come or
# go — eww rebuilds a `for` loop whenever its variable changes, which would close an open
# hover card, so the fast-changing details travel separately:
# `eww update agentinfo=` {id: {...}} whenever any detail changes.
#
# Claude Code: every interactive session keeps ~/.claude/sessions/<pid>.json with a live
#   status: busy -> working, waiting (a permission/question/dialog is open) -> input,
#   idle -> done (or "ready" if it hasn't run a turn yet). Title / tokens / working time come
#   from its transcript (~/.claude/projects/<cwd>/<sessionId>.jsonl, read incrementally).
# Codex: every TUI (`codex` on a tty) talks to an app-server that writes the thread to
#   ~/.codex/state_5.sqlite + a rollout jsonl. The TUI is matched to its thread by cwd and
#   time; state comes from scripts/agent-hook (hooks in ~/.codex/hooks.json — the only way
#   to see approval prompts) and falls back to task_started / task_complete in the rollout.
# Copilot CLI: every live session holds ~/.copilot/session-state/<id>/inuse.<pid>.lock and
#   appends every event to events.jsonl next to it (read incrementally): an open
#   permission.requested / ask_user call -> input, inside a prompt's turns -> working,
#   after the last turn_end / abort -> done. Title from workspace.yaml (the session name).
# The window: agents inherit WINDOWID from their terminal (ghostty, xterm, alacritty...);
#   otherwise the nearest ancestor that owns an X window (_NET_WM_PID).
import calendar, glob, json, os, re, sqlite3, subprocess, sys, time

HOME = os.path.expanduser("~")
RUN = os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
EWW = os.path.expanduser("~/.config/i3/bin/eww")
CLAUDE_SESS = f"{HOME}/.claude/sessions"
CLAUDE_PROJ = f"{HOME}/.claude/projects"
CODEX_DB = f"{HOME}/.codex/state_5.sqlite"
CODEX_INDEX = f"{HOME}/.codex/session_index.jsonl"
CODEX_HOOKS = f"{RUN}/agents/codex"
COPILOT_STATE = f"{HOME}/.copilot/session-state"
TICK = 1.0
CARD_BAR = 288            # px width of the bars in the hover card (eww.yuck agentcard)

CLK = os.sysconf("SC_CLK_TCK")
BOOT = next(float(l.split()[1]) for l in open("/proc/stat") if l.startswith("btime"))


# ── small helpers ────────────────────────────────────────────────────────────
def read_json(path):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def proc_start(pid):
    try:
        with open(f"/proc/{pid}/stat") as f:
            fields = f.read().rsplit(")", 1)[1].split()
        return BOOT + int(fields[19]) / CLK
    except (OSError, IndexError, ValueError):
        return None


def proc_comm(pid):
    try:
        with open(f"/proc/{pid}/comm") as f:
            return f.read().strip()
    except OSError:
        return ""


def proc_ppid(pid):
    try:
        with open(f"/proc/{pid}/stat") as f:
            return int(f.read().rsplit(")", 1)[1].split()[1])
    except (OSError, IndexError, ValueError):
        return 0


def has_tty(pid):
    try:
        return int(open(f"/proc/{pid}/stat").read().rsplit(")", 1)[1].split()[4]) != 0
    except (OSError, IndexError, ValueError):
        return False


def human_tokens(n):
    n = int(n or 0)
    if n >= 1_000_000:
        v = n / 1_000_000
        return f"{v:.1f}M".replace(".0M", "M") if v < 100 else f"{v:.0f}M"
    if n >= 1000:
        v = n / 1000
        return f"{v:.1f}k".replace(".0k", "k") if v < 10 else f"{v:.0f}k"
    return str(n)


def human_dur(sec):
    sec = max(0, int(sec))
    if sec < 60:
        return f"{sec}s"
    if sec < 3600:
        return f"{sec // 60}m"
    return f"{sec // 3600}h {sec // 60 % 60:02d}m"


_win_cache = {}


def window_of(pid):
    """X window id of the terminal running `pid` (0 if unknown)"""
    if pid in _win_cache:
        return _win_cache[pid]
    wid = 0
    try:
        env = open(f"/proc/{pid}/environ", "rb").read().split(b"\0")
        for kv in env:
            if kv.startswith((b"WINDOWID=", b"ALACRITTY_WINDOW_ID=")):
                wid = int(kv.split(b"=", 1)[1] or 0)
                break
    except (OSError, ValueError):
        pass
    if not wid:      # walk up to whoever owns an X window
        p = pid
        for _ in range(12):
            p = proc_ppid(p)
            if p <= 1:
                break
            out = subprocess.run(["xdotool", "search", "--pid", str(p)], capture_output=True, text=True).stdout.split()
            if out:
                wid = int(out[-1])
                break
    _win_cache[pid] = wid
    return wid


def pretty_model(m):
    m = (m or "").replace("claude-", "")
    mm = re.match(r"([a-z]+)-(\d+)(?:-(\d+))?", m)
    if mm and mm.group(1) in ("opus", "sonnet", "haiku", "fable"):
        return mm.group(1) + " " + mm.group(2) + ("." + mm.group(3) if mm.group(3) and len(mm.group(3)) < 3 else "")
    return m


# ── Claude Code ──────────────────────────────────────────────────────────────
class ClaudeTranscript:
    """incremental reader: title, token totals, current context, working time"""

    def __init__(self, path):
        self.path, self.off, self.buf = path, 0, b""
        self.title = self.prompt = self.model = self.effort = ""
        self.msgs = {}             # message id -> (input incl. cache, output)
        self.ctx = 0
        self.turn_ms = 0
        self.turns = 0

    def update(self):
        try:
            size = os.path.getsize(self.path)
        except OSError:
            return
        if size < self.off:        # rewritten
            self.__init__(self.path)
        if size == self.off:
            return
        with open(self.path, "rb") as f:
            f.seek(self.off)
            data = self.buf + f.read()
            self.off = f.tell()
        lines = data.split(b"\n")
        self.buf = lines.pop()     # partial last line
        for raw in lines:
            if not raw or raw[:1] != b"{":
                continue
            t = raw[:120]
            if (b'"assistant"' not in raw[:400] and b'"ai-title"' not in t and b'"last-prompt"' not in t
                    and b'"turn_duration"' not in raw[:300] and b'"custom-title"' not in t
                    and b'"type":"api-request"' not in t):
                continue
            try:
                d = json.loads(raw)
            except ValueError:
                continue
            ty = d.get("type")
            if ty == "assistant" and not d.get("isSidechain"):
                m = d.get("message") or {}
                u = m.get("usage") or {}
                if not u:
                    continue
                inp = (u.get("input_tokens") or 0) + (u.get("cache_read_input_tokens") or 0) + \
                      (u.get("cache_creation_input_tokens") or 0)
                self.msgs[m.get("id") or d.get("uuid")] = (inp, u.get("output_tokens") or 0)
                self.ctx = inp + (u.get("output_tokens") or 0)
                if m.get("model") and not m["model"].startswith("<"):
                    self.model = m["model"]
            elif ty == "api-request":
                eff = ((d.get("params") or {}).get("output_config") or {}).get("effort")
                if eff:
                    self.effort = eff
            elif ty in ("ai-title", "custom-title"):
                self.title = d.get("aiTitle") or d.get("customTitle") or d.get("title") or self.title
            elif ty == "last-prompt":
                self.prompt = d.get("lastPrompt") or self.prompt
            elif ty == "system" and d.get("subtype") == "turn_duration":
                self.turn_ms += d.get("durationMs") or 0
                self.turns += 1

    def totals(self):
        return sum(v[0] for v in self.msgs.values()), sum(v[1] for v in self.msgs.values())


_claude_tx = {}


def claude_default_effort(model):
    """effortLevel from ~/.claude/settings.json for a session that hasn't sent a request yet"""
    st = read_json(f"{HOME}/.claude/settings.json") or {}
    ms = st.get("modelSettings") or {}
    return (ms.get(model or "") or {}).get("effortLevel") or st.get("effortLevel") or ""


def claude_window(model, ctx):
    big = re.search(r"opus-(4-[6-9]|[5-9])|sonnet-([5-9])|fable|\[1m\]|-1m", model or "")
    win = 1_000_000 if big else 200_000
    return win if ctx <= win else 1_000_000


def claude_sessions(now):
    out = {}
    for f in glob.glob(f"{CLAUDE_SESS}/*.json"):
        r = read_json(f)
        if not r or r.get("kind", "interactive") != "interactive":
            continue
        pid = int(r.get("pid") or 0)
        if not pid or proc_comm(pid) != "claude" or not has_tty(pid):
            continue
        sid = r.get("sessionId") or ""
        cwd = r.get("cwd") or ""
        path = os.path.join(CLAUDE_PROJ, re.sub(r"[^A-Za-z0-9]", "-", cwd), sid + ".jsonl")
        if not os.path.exists(path):
            hits = glob.glob(f"{CLAUDE_PROJ}/*/{sid}.jsonl")
            path = hits[0] if hits else path
        tx = _claude_tx.get(pid)
        if tx is None or tx.path != path:
            tx = _claude_tx[pid] = ClaudeTranscript(path)
        tx.update()
        status = r.get("status") or "idle"
        if status == "waiting":
            state = "input"
        elif status in ("busy", "shell"):
            state = "working"
        else:
            state = "done" if tx.turns or tx.msgs else "ready"
        since = (r.get("statusUpdatedAt") or r.get("startedAt") or now * 1000) / 1000
        started = (r.get("startedAt") or now * 1000) / 1000
        active = tx.turn_ms / 1000 + (now - since if state == "working" else 0)
        inp, outp = tx.totals()
        title = tx.title or (tx.prompt[:60] if tx.prompt else "") or "new session"
        out[f"claude-{pid}"] = dict(
            kind="claude", pid=pid, state=state, title=title, cwd=cwd,
            model=pretty_model(tx.model or ""), effort=tx.effort or claude_default_effort(tx.model), since=since, started=started, active=active,
            ctx=tx.ctx, ctxmax=claude_window(tx.model, tx.ctx), tin=inp, tout=outp,
            waiting=r.get("waitingFor") or "", wid=window_of(pid))
    for pid in list(_claude_tx):
        if f"claude-{pid}" not in out:
            del _claude_tx[pid]
    return out


# ── Codex ────────────────────────────────────────────────────────────────────
EFFORT_RE = re.compile(rb'"(?:reasoning_)?effort":"([a-z]+)"')


class CodexRollout:
    def __init__(self, path):
        self.path, self.off, self.buf = path, 0, b""
        self.state, self.state_ts = "ready", 0.0
        self.total = self.inp = self.outp = self.ctx = 0
        self.ctxmax = 0
        self.active = 0.0
        self.turn_start = None
        self.prompt = ""
        self.effort = ""

    def update(self):
        try:
            size = os.path.getsize(self.path)
        except OSError:
            return
        if size < self.off:
            self.__init__(self.path)
        if size == self.off:
            return
        with open(self.path, "rb") as f:
            f.seek(self.off)
            data = self.buf + f.read()
            self.off = f.tell()
        lines = data.split(b"\n")
        self.buf = lines.pop()
        for raw in lines:
            m = EFFORT_RE.search(raw)
            if m:
                self.effort = m.group(1).decode()
            if b'"event_msg"' not in raw[:200]:
                continue
            try:
                d = json.loads(raw)
            except ValueError:
                continue
            p = d.get("payload") or {}
            ty = p.get("type")
            ts = d.get("timestamp")
            try:
                tsec = time.mktime(time.strptime(ts[:19], "%Y-%m-%dT%H:%M:%S")) - time.timezone if ts else time.time()
            except ValueError:
                tsec = time.time()
            if ty == "task_started":
                self.state, self.state_ts, self.turn_start = "working", tsec, tsec
                self.ctxmax = p.get("model_context_window") or self.ctxmax
            elif ty in ("task_complete", "turn_aborted"):
                if self.turn_start:
                    self.active += max(0, tsec - self.turn_start)
                self.state, self.state_ts, self.turn_start = "done", tsec, None
            elif ty == "user_message" and not self.prompt:
                self.prompt = (p.get("message") or "").strip().splitlines()[0][:80] if p.get("message") else ""
            elif ty == "token_count":
                info = p.get("info") or {}
                tot = info.get("total_token_usage") or {}
                last = info.get("last_token_usage") or {}
                self.inp = tot.get("input_tokens") or 0
                self.outp = (tot.get("output_tokens") or 0)
                self.total = tot.get("total_tokens") or 0
                self.ctx = last.get("total_tokens") or self.ctx
                self.ctxmax = info.get("model_context_window") or self.ctxmax


_codex_rollouts = {}


def codex_config(key):
    """top-level value from ~/.codex/config.toml (the defaults a session runs with)"""
    try:
        for l in open(f"{HOME}/.codex/config.toml"):
            if l.lstrip().startswith("["):
                break
            m = re.match(r'\s*' + key + r'\s*=\s*"([^"]+)"', l)
            if m:
                return m.group(1)
    except OSError:
        pass
    return ""


def codex_default_model():
    """model a fresh Codex session will use (before its first turn records one)"""
    return codex_config("model")
_codex_names = {"mtime": 0, "map": {}}


def codex_names():
    try:
        mt = os.path.getmtime(CODEX_INDEX)
    except OSError:
        return {}
    if mt != _codex_names["mtime"]:
        m = {}
        try:
            for l in open(CODEX_INDEX):
                try:
                    d = json.loads(l)
                    if d.get("thread_name"):
                        m[d["id"]] = d["thread_name"]
                except ValueError:
                    pass
        except OSError:
            pass
        _codex_names.update(mtime=mt, map=m)
    return _codex_names["map"]


def codex_threads(cwd, since_ms):
    try:
        c = sqlite3.connect(f"file:{CODEX_DB}?mode=ro", uri=True, timeout=0.5)
        rows = c.execute(
            "select id, rollout_path, title, model, coalesce(created_at_ms, created_at*1000), "
            "coalesce(updated_at_ms, updated_at*1000), first_user_message from threads "
            "where cwd = ? and coalesce(updated_at_ms, updated_at*1000) >= ? and archived = 0 "
            "and (agent_role is null or agent_role = '') order by 6 desc", (cwd, since_ms)).fetchall()
        c.close()
        return rows
    except sqlite3.Error:
        return []


# Codex (0.16x) mirrors its state in the terminal title, e.g.
#   "[ . ] Action Required | <thread> | <dir>"  while an approval / question is waiting.
_codex_wait = {}      # pid -> when its title started saying "Action Required"
CODEX_TITLE_INPUT = re.compile(r"action required|approval|needs? (your )?(input|approval)", re.I)


def window_title(wid):
    if not wid:
        return ""
    return subprocess.run(["xdotool", "getwindowname", str(wid)], capture_output=True, text=True).stdout.strip()


def codex_sessions(now):
    tuis = []
    for d in os.listdir("/proc"):
        if not d.isdigit():
            continue
        pid = int(d)
        if proc_comm(pid) != "codex" or not has_tty(pid):
            continue
        try:
            argv = open(f"/proc/{pid}/cmdline", "rb").read().split(b"\0")
        except OSError:
            continue
        if any(a in (b"app-server", b"exec", b"mcp-server", b"login", b"proto") for a in argv[1:3]):
            continue
        if proc_comm(proc_ppid(pid)) == "codex":     # the launcher re-execs itself
            continue
        try:
            cwd = os.readlink(f"/proc/{pid}/cwd")
        except OSError:
            cwd = ""
        tuis.append((proc_start(pid) or now, pid, cwd))
    tuis.sort()
    names = codex_names()
    taken, out = set(), {}
    for start, pid, cwd in tuis:
        thread = None
        for row in codex_threads(cwd, int((start - 5) * 1000)):
            if row[0] not in taken:
                thread = row
                break
        hook = None
        title, model, rollout = "new session", "", None
        if thread:
            taken.add(thread[0])
            tid, rpath, ttitle, model, _, _, first = thread
            first_line = next(iter((first or "").strip().splitlines()), "")[:60]
            title = names.get(tid) or ttitle or first_line or "new session"
            rollout = _codex_rollouts.get(rpath)
            if rollout is None:
                rollout = _codex_rollouts[rpath] = CodexRollout(rpath)
            rollout.update()
            hook = read_json(f"{CODEX_HOOKS}/{tid}.json")
        state, since = "ready", start
        if rollout:
            state, since = rollout.state, rollout.state_ts or start
        if hook and hook.get("ts", 0) >= (since - 1):
            # the hook knows about approval prompts; a finished turn in the rollout wins over
            # an older hook event
            state, since = hook["state"], hook["ts"]
        wid = window_of(pid)
        # the TUI's own title is the most reliable "waiting on you" signal (no hook needed)
        if CODEX_TITLE_INPUT.search(window_title(wid)):
            if state != "input":
                since = _codex_wait.setdefault(pid, now)
            state = "input"
        else:
            _codex_wait.pop(pid, None)
        active = (rollout.active if rollout else 0) + (now - rollout.turn_start if rollout and rollout.turn_start else 0)
        ctxmax = (rollout.ctxmax if rollout else 0) or 272_000
        out[f"codex-{pid}"] = dict(
            kind="codex", pid=pid, state=state, title=title, cwd=cwd, model=model or codex_default_model(),
            effort=(rollout.effort if rollout else "") or codex_config("model_reasoning_effort"),
            since=since, started=start, active=active,
            ctx=rollout.ctx if rollout else 0, ctxmax=ctxmax,
            tin=rollout.inp if rollout else 0, tout=rollout.outp if rollout else 0,
            waiting="", wid=wid)
    return out


# ── GitHub Copilot CLI ───────────────────────────────────────────────────────
def iso_ts(ts):
    try:
        return calendar.timegm(time.strptime(ts[:19], "%Y-%m-%dT%H:%M:%S")) + float("0" + ts[19:23].rstrip("Z"))
    except (TypeError, ValueError):
        return time.time()


COPILOT_TYPES = (b'"user.message"', b'"assistant.turn_start"', b'"assistant.turn_end"', b'"abort"',
                 b'"session.shutdown"', b'"session.usage_record"', b'"session.model_change"',
                 b'"permission.requested"', b'"permission.completed"', b'"tool.execution_start"',
                 b'"tool.execution_complete"', b'"session.compaction_complete"')
COPILOT_ASK_TOOLS = ("ask_user", "exit_plan_mode")


class CopilotEvents:
    """incremental reader of session-state/<id>/events.jsonl"""

    def __init__(self, path):
        self.path, self.off, self.buf = path, 0, b""
        self.model = self.effort = self.prompt = ""
        self.inp = self.outp = self.ctx = self.ctxmax = 0
        self.prompted = False
        self.busy = False                  # inside a user interaction (prompt -> last turn_end)
        self.last_end = 0.0                # ts of the latest turn_end / abort
        self.work_since = 0.0
        self.turn_start = None
        self.active = 0.0
        self.perms = {}                    # pending permission requestId -> ts
        self.asks = {}                     # pending ask_user toolCallId -> ts

    def update(self):
        try:
            size = os.path.getsize(self.path)
        except OSError:
            return
        if size < self.off:
            self.__init__(self.path)
        if size == self.off:
            return
        with open(self.path, "rb") as f:
            f.seek(self.off)
            data = self.buf + f.read()
            self.off = f.tell()
        lines = data.split(b"\n")
        self.buf = lines.pop()
        for raw in lines:
            if not raw.startswith(b'{"type":') or not raw[8:48].startswith(COPILOT_TYPES):
                continue
            try:
                e = json.loads(raw)
            except ValueError:
                continue
            ty, d, ts = e.get("type"), e.get("data") or {}, iso_ts(e.get("timestamp"))
            if ty == "user.message":
                self.prompted = True
                if not self.busy:
                    self.busy, self.work_since = True, ts
                if not self.prompt:
                    self.prompt = next(iter((d.get("content") or "").strip().splitlines()), "")[:60]
            elif ty == "assistant.turn_start":
                self.turn_start = ts
                if not self.busy:
                    self.busy, self.work_since = True, ts
            elif ty == "assistant.turn_end":
                if self.turn_start:
                    self.active += max(0, ts - self.turn_start)
                self.turn_start, self.last_end = None, ts
            elif ty in ("abort", "session.shutdown"):
                if self.turn_start:
                    self.active += max(0, ts - self.turn_start)
                self.turn_start, self.busy, self.last_end = None, False, ts
                self.perms.clear()
                self.asks.clear()
            elif ty == "session.model_change":
                self.model = d.get("newModel") or self.model
                self.effort = d.get("reasoningEffort") or self.effort
            elif ty == "session.usage_record":
                u = d.get("usage") or {}
                self.inp += u.get("inputTokens") or 0
                self.outp += u.get("outputTokens") or 0
                if u.get("initiator") in ("user", "agent") and not d.get("parentToolCallId"):
                    self.ctx = (u.get("inputTokens") or 0) + (u.get("outputTokens") or 0)
                    self.ctxmax = u.get("maxPromptTokens") or self.ctxmax
                    self.model = u.get("model") or self.model
            elif ty == "session.compaction_complete":
                self.ctx = (d.get("postCompactionTokens") or 0) or self.ctx
            elif ty == "permission.requested":
                self.perms[d.get("requestId")] = ts
            elif ty == "permission.completed":
                self.perms.pop(d.get("requestId"), None)
            elif ty == "tool.execution_start" and d.get("toolName") in COPILOT_ASK_TOOLS:
                self.asks[d.get("toolCallId")] = ts
            elif ty == "tool.execution_complete":
                self.asks.pop(d.get("toolCallId"), None)

    def state(self, now):
        """(state, since, waiting-for)"""
        pend = list(self.perms.values()) + list(self.asks.values())
        if pend:
            return "input", min(pend), "permission" if self.perms else "question"
        if (self.busy and self.turn_start is None and self.last_end >= self.work_since
                and now - self.last_end > 2):
            # turn_end with no next turn_start: the interaction is over (turns follow each
            # other within milliseconds while the agent is still going)
            self.busy = False
        if self.busy:
            return "working", self.work_since, ""
        if self.prompted:
            return "done", self.last_end or self.work_since, ""
        return "ready", 0, ""


_copilot_ev = {}


def copilot_settings():
    try:   # settings.json may carry // comments
        txt = open(f"{HOME}/.copilot/settings.json").read()
        return json.loads(re.sub(r"^\s*//.*$", "", txt, flags=re.M))
    except (OSError, ValueError):
        return {}


def copilot_model_name(m):
    m = (m or "").replace("claude-", "")
    mm = re.match(r"(opus|sonnet|haiku|fable)-(\d+(?:[.-]\d)?)", m)
    return f"{mm.group(1)} {mm.group(2).replace('-', '.')}" if mm else m


def workspace_name(path):
    name = summary = ""
    try:
        for l in open(path):
            if l.startswith("name:"):
                name = l[5:].strip().strip("'\"")
            elif l.startswith("summary:"):
                summary = l[8:].strip().strip("'\"")
    except OSError:
        pass
    return name or summary


def copilot_sessions(now):
    def mtime(sdir):
        try:
            return os.path.getmtime(f"{sdir}/events.jsonl")
        except OSError:
            return 0

    found = {}                 # pid -> session dir (newest if one process switched sessions)
    for lock in glob.glob(f"{COPILOT_STATE}/*/inuse.*.lock"):
        try:
            pid = int(lock.rsplit(".", 2)[1])
        except (IndexError, ValueError):
            continue
        sdir = os.path.dirname(lock)
        if pid in found and mtime(found[pid]) >= mtime(sdir):
            continue
        found[pid] = sdir
    st = None
    out = {}
    for pid, sdir in found.items():
        if not has_tty(pid):
            continue
        try:
            argv = open(f"/proc/{pid}/cmdline", "rb").read().split(b"\0")
        except OSError:
            continue
        if os.path.basename(argv[0]) != b"copilot" or any(
                a in (b"-p", b"--prompt", b"--acp") or a.startswith(b"--prompt=") for a in argv[1:]):
            continue
        path = f"{sdir}/events.jsonl"
        ev = _copilot_ev.get(pid)
        if ev is None or ev.path != path:
            ev = _copilot_ev[pid] = CopilotEvents(path)
        ev.update()
        start = proc_start(pid) or now
        state, since, waiting = ev.state(now)
        if st is None:
            st = copilot_settings()
        cwd = ""
        try:
            cwd = os.readlink(f"/proc/{pid}/cwd")
        except OSError:
            pass
        title = workspace_name(f"{sdir}/workspace.yaml") or ev.prompt or "new session"
        active = ev.active + (now - ev.turn_start if ev.turn_start else 0)
        out[f"copilot-{pid}"] = dict(
            kind="copilot", pid=pid, state=state, title=title, cwd=cwd,
            model=copilot_model_name(ev.model or st.get("model") or ""),
            effort=ev.effort or st.get("effortLevel") or "",
            since=since or start, started=start, active=active,
            ctx=ev.ctx, ctxmax=ev.ctxmax or 200_000, tin=ev.inp, tout=ev.outp,
            waiting=waiting, wid=window_of(pid))
    for pid in list(_copilot_ev):
        if f"copilot-{pid}" not in out:
            del _copilot_ev[pid]
    return out


# ── output ───────────────────────────────────────────────────────────────────
STATE_TEXT = {"working": "working", "input": "needs you", "done": "finished", "ready": "ready"}


def card(s, now):
    age = max(1, now - s["started"])
    ctx_pct = min(100, round(100 * s["ctx"] / s["ctxmax"])) if s["ctxmax"] else 0
    act = min(age, s["active"])
    act_pct = round(100 * act / age)
    proj = os.path.basename(s["cwd"].rstrip("/")) or "~"
    if s["cwd"].rstrip("/") == HOME:
        proj = "~"
    return {
        "kind": s["kind"], "state": s["state"], "title": s["title"],
        "statetext": STATE_TEXT[s["state"]] + (f" · {s['waiting']}" if s["state"] == "input" and s["waiting"] else ""),
        "since": human_dur(now - s["since"]),
        "proj": proj, "model": s["model"], "effort": s.get("effort") or "",
        "ctx": human_tokens(s["ctx"]), "ctxmax": human_tokens(s["ctxmax"]), "ctxpct": ctx_pct,
        "ctxpx": max(0, round(CARD_BAR * ctx_pct / 100)),
        "ctxlevel": "hi" if ctx_pct >= 80 else "mid" if ctx_pct >= 50 else "lo",
        "tin": human_tokens(s["tin"]), "tout": human_tokens(s["tout"]),
        "age": human_dur(age), "active": human_dur(act), "actpct": act_pct,
        "actpx": max(0, round(CARD_BAR * act_pct / 100)),
        "wid": s["wid"],
    }


def main():
    last_ids, last_info = None, None
    while True:
        now = time.time()
        sess = {}
        try:
            sess.update(claude_sessions(now))
        except Exception as e:           # never let one bad file kill the bar module
            print(f"claude: {e}", file=sys.stderr)
        try:
            sess.update(codex_sessions(now))
        except Exception as e:
            print(f"codex: {e}", file=sys.stderr)
        try:
            sess.update(copilot_sessions(now))
        except Exception as e:
            print(f"copilot: {e}", file=sys.stderr)
        ids = [k for k, _ in sorted(sess.items(), key=lambda kv: kv[1]["started"])]
        info = json.dumps({k: card(v, now) for k, v in sess.items()}, ensure_ascii=False)
        if info != last_info:
            subprocess.run([EWW, "update", f"agentinfo={info}"], capture_output=True)
            last_info = info
        if ids != last_ids:
            print(json.dumps(ids), flush=True)
            last_ids = ids
        time.sleep(TICK)


if __name__ == "__main__":
    if sys.argv[1:] == ["dump"]:          # debugging: one snapshot
        now = time.time()
        s = {**claude_sessions(now), **codex_sessions(now), **copilot_sessions(now)}
        print(json.dumps({k: card(v, now) for k, v in s.items()}, indent=1, ensure_ascii=False))
    else:
        main()
