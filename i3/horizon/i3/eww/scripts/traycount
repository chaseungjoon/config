#!/usr/bin/env python3
# eww listener: how many tray icons are actually shown (background apps like Steam / ChatGPT),
# so the systray pill only appears when it has something in it. Passive items are hidden by eww,
# and nm-applet / blueman are drawn natively in the bar, so neither counts.
from gi.repository import Gio, GLib

SKIP = {"nm-applet", "blueman"}
bus = Gio.bus_get_sync(Gio.BusType.SESSION)
last = None

def prop(name, path, iface, key):
    try:
        return bus.call_sync(name, path, "org.freedesktop.DBus.Properties", "Get",
                             GLib.Variant("(ss)", (iface, key)), None, 0, 500, None).unpack()[0]
    except GLib.Error:
        return None

def emit(*_):
    global last
    items = prop("org.kde.StatusNotifierWatcher", "/StatusNotifierWatcher",
                 "org.kde.StatusNotifierWatcher", "RegisteredStatusNotifierItems") or []
    n = 0
    for item in items:
        name, _, path = item.partition("/")
        path = "/" + path if path else "/StatusNotifierItem"
        if prop(name, path, "org.kde.StatusNotifierItem", "Status") in (None, "Passive"):
            continue
        if prop(name, path, "org.kde.StatusNotifierItem", "Id") in SKIP:
            continue
        n += 1
    if n != last:
        print(n, flush=True)
        last = n
    return True

# registrations, unregistrations and status flips; a slow poll catches anything missed
for iface, member in (("org.kde.StatusNotifierWatcher", None), ("org.kde.StatusNotifierItem", "NewStatus")):
    bus.signal_subscribe(None, iface, member, None, None, 0, lambda *a: GLib.timeout_add(150, lambda: emit() and False))
GLib.timeout_add_seconds(5, emit)
emit()
GLib.MainLoop().run()
