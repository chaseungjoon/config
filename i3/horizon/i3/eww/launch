#!/usr/bin/env bash
# (re)start the eww bar on every active monitor; replaces the old polybar islands
. ~/.config/i3/scripts/_env
pkill -x polybar 2>/dev/null
eww=~/.config/i3/bin/eww
$eww ping >/dev/null 2>&1 || { $eww daemon >/dev/null 2>&1; for _ in $(seq 50); do $eww ping >/dev/null 2>&1 && break; sleep 0.1; done; }
$eww close-all >/dev/null 2>&1
$eww reload >/dev/null 2>&1
i=0
while read -r name; do
    $eww open bar --id "bar-$i" --arg monitor="$i" --arg output="$name"
    i=$((i + 1))
done < <(xrandr --listactivemonitors | awk 'NR>1 {print $NF}')
# hide the bar while a window is fullscreen (it's override-redirect, so i3 can't cover it)
pkill -f 'eww/scripts/fullscreen-watch$' 2>/dev/null
setsid -f ~/.config/i3/eww/scripts/fullscreen-watch >/dev/null 2>&1
# agent hover card: kept open but unmapped so hovering an agent icon shows it instantly
$eww open agentcard --pos=-4000x0 >/dev/null 2>&1
for _ in $(seq 30); do w=$(xdotool search --name '^Eww - agentcard$' | head -1); [[ -n $w ]] && break; sleep 0.05; done
[[ -n $w ]] && xdotool windowunmap "$w"
