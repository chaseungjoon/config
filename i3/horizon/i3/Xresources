! 27-inch 2560x1440 at 96 dpi, matching the GNOME session at 100% scale
Xft.dpi:       96
Xft.antialias: true
Xft.hinting:   true
Xft.hintstyle: hintslight
Xft.rgba:      rgb
Xft.lcdfilter: lcddefault
Xcursor.theme: Vimix-white-cursors
Xcursor.size:  24

