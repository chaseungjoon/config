# dunst :: EVENT HORIZON — glass cards, rounded, fades handled by picom
[global]
    monitor = 0
    follow = keyboard
    width = (320, 440)
    height = 300
    origin = top-right
    offset = 14x60
    notification_limit = 6
    progress_bar = true
    progress_bar_height = 8
    progress_bar_frame_width = 0
    progress_bar_min_width = 280
    progress_bar_max_width = 420
    progress_bar_corner_radius = 4
    highlight = "#2b5cff"
    indicate_hidden = yes
    transparency = 0
    separator_height = 1
    padding = 14
    horizontal_padding = 16
    text_icon_padding = 14
    frame_width = 1
    frame_color = "#ffffff12"
    separator_color = frame
    gap_size = 8
    sort = yes
    font = Inter 10.5
    line_height = 2
    markup = full
    format = "<b>%s</b>\n<span color='#9db0d3'>%b</span>"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = no
    icon_theme = "Papirus-Dark, Papirus, Adwaita"
    enable_recursive_icon_lookup = true
    icon_position = left
    min_icon_size = 32
    max_icon_size = 48
    sticky_history = yes
    history_length = 50
    browser = /usr/bin/xdg-open
    always_run_script = true
    corner_radius = 14
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#070c18b8"
    foreground = "#e1e9f7"
    highlight = "#9db0d3"
    timeout = 3

[urgency_normal]
    background = "#070c18b8"
    foreground = "#e1e9f7"
    highlight = "#2b5cff"
    timeout = 6

[urgency_critical]
    background = "#1f0e14b8"
    foreground = "#ffe4e8"
    frame_color = "#ff6b81"
    highlight = "#ff6b81"
    timeout = 0

[osd]
    appname = osd
    format = "<b>%s</b>"
    highlight = "#2b5cff"
    history_ignore = yes
    timeout = 2
