#!/usr/bin/env bash
# ibus with exactly two engines: English (US) and Hangul — SUPER+D flips between them (scripts/ime).
# -r replaces any daemon still shutting down from the GNOME session (that race used to leave no IME at all)
gsettings set org.freedesktop.ibus.general preload-engines "['xkb:us::eng', 'hangul']"
gsettings set org.freedesktop.ibus.general engines-order "['xkb:us::eng', 'hangul']"
gsettings set org.freedesktop.ibus.general.hotkey triggers "[]"          # i3 owns Super+Space
gsettings set org.freedesktop.ibus.engine.hangul initial-input-mode 'hangul'
ibus-daemon -drx
for _ in $(seq 40); do ibus engine >/dev/null 2>&1 && break; sleep 0.25; done
ibus engine xkb:us::eng 2>/dev/null
exit 0
