#!/usr/bin/env python3
# clipboard history daemon (clipmenud replacement): listens for CLIPBOARD owner
# changes via XFixes and keeps the last 50 text entries in $XDG_RUNTIME_DIR/i3-clip.json
import json, os, subprocess, sys
sys.path.insert(0, os.path.expanduser("~/.local/opt/i3-extras/root/usr/lib/python3/dist-packages"))
from Xlib import display
from Xlib.ext import xfixes

STORE = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "i3-clip.json")
LIMIT, MAXLEN = 50, 100_000


def grab():
    try:
        targets = subprocess.run(["xclip", "-o", "-selection", "clipboard", "-t", "TARGETS"],
                                 capture_output=True, text=True, timeout=1).stdout
        if "UTF8_STRING" not in targets and "STRING" not in targets:
            return None                                  # images, files, password-manager hints…
        if "x-kde-passwordManagerHint" in targets:
            return None
        out = subprocess.run(["xclip", "-o", "-selection", "clipboard"],
                             capture_output=True, timeout=1).stdout.decode("utf-8", "replace")
        return out if out.strip() and len(out) <= MAXLEN else None
    except Exception:
        return None


def remember(text):
    try:
        with open(STORE) as f:
            hist = json.load(f)
    except Exception:
        hist = []
    hist = [text] + [h for h in hist if h != text]
    tmp = STORE + ".tmp"
    with open(tmp, "w") as f:
        json.dump(hist[:LIMIT], f)
    os.chmod(tmp, 0o600)
    os.replace(tmp, STORE)


d = display.Display()
if not d.has_extension("XFIXES"):
    sys.exit("clipd: XFIXES missing")
d.xfixes_query_version()
root = d.screen().root
d.xfixes_select_selection_input(root, d.intern_atom("CLIPBOARD"), xfixes.XFixesSetSelectionOwnerNotifyMask)
while True:
    ev = d.next_event()
    if type(ev).__name__ == "SetSelectionOwnerNotify":   # python-xlib clones event classes per display
        text = grab()
        if text:
            remember(text)
