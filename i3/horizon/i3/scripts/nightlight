#!/usr/bin/env bash
# toggle a warm colour temperature (one-shot, no daemon)
. ~/.config/i3/scripts/_env
state=${XDG_RUNTIME_DIR:-/tmp}/nightlight.on
if [[ -f $state ]]; then
    redshift -P -x >/dev/null 2>&1; rm -f "$state"
    notify-send -a osd -u low -i weather-clear "Night light" "off"
else
    redshift -P -O 3800 >/dev/null 2>&1; touch "$state"
    notify-send -a osd -u low -i weather-clear-night "Night light" "3800 K"
fi
