#!/usr/bin/env python3
# minimal autotiling: split the focused window along its longer side, so new
# windows spiral instead of all stacking in one row
import os, sys
sys.path.insert(0, os.path.expanduser("~/.local/opt/i3-extras/root/usr/lib/python3/dist-packages"))
import i3ipc


def on_focus(i3, _event):
    con = i3.get_tree().find_focused()
    if not con or con.type != "con" or con.floating in ("auto_on", "user_on") or con.fullscreen_mode:
        return
    if con.parent and con.parent.layout in ("stacked", "tabbed"):
        return
    want = "splith" if con.rect.width > con.rect.height else "splitv"
    if con.parent and con.parent.layout != want:
        i3.command(want)


i3 = i3ipc.Connection()
i3.on(i3ipc.Event.WINDOW_FOCUS, on_focus)
i3.on(i3ipc.Event.WINDOW_NEW, on_focus)
i3.main()
