#!/bin/sh
# picom v13 build with animation support.
# NVIDIA: queue at most one frame so every animation frame lands on the next vblank
# instead of being buffered 2-3 deep (the driver default), smoother and lower latency
export __GL_MaxFramesAllowed=1
export __GL_SYNC_TO_VBLANK=1
exec "$HOME/.local/opt/i3-extras/picom13/bin/picom" "$@"
